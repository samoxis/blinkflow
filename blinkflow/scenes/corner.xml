<!-- BlinkFlow scene `corner`, attached to Pollen Robotics' microduck_rl scene_demo.xml (see __init__.py).
     Two red walls meeting in a corner just inside the office door, open towards the robot, so it walks
     into it: vertex at (1.00, 0.33), arms 0.35 m long, 120 deg apart. The loader removes the office
     cabinet (`off_cabinet`), which stood where the lower arm is. Tests the stop threshold, the choice
     of direction and the turn out of a corner. Angles in degrees: a fragment has its own compiler. -->
<mujoco model="bf_corner">
  <worldbody>
    <body name="bf_corner">
      <geom name="bf_corner_wall_l" type="box" size="0.175 0.02 0.20" pos="0.9125 0.4816 0.20"
            euler="0 0 120" rgba="0.85 0.12 0.12 1" contype="1" conaffinity="1"/>
      <geom name="bf_corner_wall_r" type="box" size="0.175 0.02 0.20" pos="0.9125 0.1784 0.20"
            euler="0 0 -120" rgba="0.85 0.12 0.12 1" contype="1" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
